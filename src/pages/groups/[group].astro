---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LoopMark from '../../components/LoopMark.astro';
import { groupRow } from '../../lib/groupRow';

// One page per group (models sharing a `group` in their frontmatter). The homepage shows the
// group as a single row; this page is where you pick a member and go to its full detail page.
export async function getStaticPaths() {
	const models = await getCollection('models');
	const ids = [...new Set(models.map((m) => m.data.group).filter(Boolean))] as string[];
	return ids.map((id) => ({
		params: { group: id },
		props: { members: models.filter((m) => m.data.group === id).sort((a, b) => b.data.order - a.data.order) },
	}));
}

const { members } = Astro.props;
const row = groupRow(Astro.params.group!, members);
const totalRuns = members.reduce((n, m) => n + (m.data.runs ?? 0), 0);
const totalConvos = members.reduce(
	(n, m) => n + m.data.transcripts.reduce((k, t) => k + (t.runs ?? 1), 0),
	0,
);
---

<Layout title={`${row.model} — AttractorBench`}>
	<main class="page">
		<p class="back"><a href="/">← all models</a></p>

		<header class="head">
			<h1 class="model">{row.model}</h1>
			<p class="drawn">
				{members.length} training variants · <strong>{row.attractor}</strong>
			</p>
			<p class="meta">
				{totalRuns ? `${totalRuns} runs` : ''}
				{totalConvos ? ` · ${totalConvos} conversations` : ''}
			</p>
			<p class="note">
				These are variants of one training sweep, grouped so they take a single row on the
				homepage. Each keeps its own full page — pick one below. The shared wording above is
				derived from the variants' own headlines, not written by hand, so it narrows if they
				ever stop agreeing.
			</p>
		</header>

		<section class="members">
			<h2 class="section-title">Variants</h2>
			<div class="table-scroll" role="region" aria-label={`${row.model} variants`} tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col">Variant</th>
							<th scope="col">Attractor state</th>
							<th scope="col">Terminal form</th>
						</tr>
					</thead>
					<tbody>
						{members.map((m) => (
							<tr>
								<td class="cell-model">
									<a href={`/models/${m.data.slug}`}>{m.data.name}</a>
								</td>
								<td class="cell-attractor">
									{m.data.headline.attractor}
									{m.data.headline.strength && (
										<span class="strength-note">{m.data.headline.strength} runs</span>
									)}
								</td>
								<td class="cell-terminal">
									{m.data.headline.terminalForm && <code>{m.data.headline.terminalForm}</code>}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<footer class="footer">
			<LoopMark size={18} />
			<p>AttractorBench · a public benchmark · runs added continuously</p>
		</footer>
	</main>
</Layout>

<style>
	.page {
		max-width: 880px;
		margin: 0 auto;
		padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 5vw, 2.5rem) 4rem;
	}

	.back {
		margin: 0 0 2rem;
		font-size: 0.85rem;
	}

	.back a {
		color: var(--ink-faint);
		text-decoration: none;
	}

	.back a:hover {
		color: var(--ink-soft);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.model {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(1.9rem, 5vw, 2.6rem);
		margin: 0;
		color: var(--ink);
	}

	.drawn {
		margin: 0.9rem 0 0;
		font-size: 1.05rem;
		color: var(--ink-soft);
		line-height: 1.6;
	}

	.drawn strong {
		color: var(--ink);
		font-weight: 600;
	}

	.meta {
		margin: 0.6rem 0 0;
		font-size: 0.82rem;
		color: var(--ink-faint);
		font-family: var(--mono);
	}

	.note {
		margin: 1.5rem 0 0;
		font-size: 0.9rem;
		line-height: 1.65;
		color: var(--ink-faint);
		max-width: 38rem;
	}

	.members {
		margin-top: 3.5rem;
	}

	.section-title {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0 0 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}

	.table-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.table-scroll:focus-visible {
		outline: 2px solid var(--ink-faint);
		outline-offset: 2px;
	}

	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
		min-width: 640px;
	}

	thead th {
		text-align: left;
		font-weight: 600;
		font-size: 0.78rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
		padding: 0.9rem 1.25rem 0.9rem 0;
		border-bottom: 1px solid var(--rule);
	}

	tbody td {
		padding: 1.05rem 1.25rem 1.05rem 0;
		border-bottom: 1px solid var(--rule-faint);
		vertical-align: top;
		line-height: 1.5;
	}

	tbody tr {
		transition: background-color 0.15s ease;
	}

	tbody tr:hover {
		background-color: var(--row-hover);
	}

	.cell-model {
		font-weight: 600;
		color: var(--ink);
		white-space: nowrap;
	}

	.cell-model a {
		color: inherit;
		text-decoration: none;
	}

	.cell-model a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.cell-attractor {
		color: var(--ink);
		max-width: 26rem;
	}

	.strength-note {
		color: var(--ink-faint);
		font-size: 0.78rem;
		font-family: var(--mono);
		white-space: nowrap;
		margin-left: 0.45em;
	}

	.cell-terminal code {
		font-family: var(--mono);
		font-size: 0.85rem;
		color: var(--ink-soft);
		background: var(--code-bg);
		padding: 0.15em 0.45em;
		border-radius: 3px;
		white-space: normal;
		word-break: break-word;
	}

	.footer {
		margin-top: 5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule-faint);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.footer :global(.loop-mark) {
		opacity: 0.4;
	}

	.footer p {
		margin: 0;
		font-size: 0.82rem;
		color: var(--ink-faint);
		letter-spacing: 0.02em;
	}
</style>
