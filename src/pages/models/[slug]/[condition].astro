---
import Layout from '../../../layouts/Layout.astro';

// Representative transcripts are published by the pipeline into src/data/transcripts/<slug>/<condition>.json
export async function getStaticPaths() {
	const all = import.meta.glob('/src/data/transcripts/*/*.json', { eager: true });
	return Object.entries(all).map(([path, mod]) => {
		const m = path.match(/transcripts\/([^/]+)\/(.+)\.json$/);
		return {
			params: { slug: m[1], condition: m[2] },
			props: { t: mod.default },
		};
	});
}

const { t } = Astro.props;
---

<Layout title={`${t.model} · ${t.condition_label} — transcript`}>
	<main class="page">
		<p class="back"><a href={`/models/${t.slug}`}>← {t.model}</a></p>
		<header class="head">
			<h1>{t.model}</h1>
			<p class="cond">{t.condition_label}</p>
			<p class="seed">seed: <em>{t.seed_prompt}</em></p>
			<p class="meta">representative run · {t.turns.length} turns</p>
		</header>

		<div class="convo">
			{t.turns.map((turn) => (
				<div class={`turn speaker-${turn.speaker}`}>
					<div class="turn-head">
						<span class="who">{turn.speaker}</span>
						<span class="model">{turn.model}</span>
						<span class="n">turn {turn.turn}</span>
					</div>
					<div class="body">{turn.content_clean}</div>
				</div>
			))}
		</div>
	</main>
</Layout>

<style>
	.page {
		max-width: 820px;
		margin: 0 auto;
		padding: clamp(2.5rem, 7vw, 5rem) clamp(1.25rem, 5vw, 2.5rem) 4rem;
	}
	.back {
		font-size: 0.85rem;
		color: var(--ink-faint);
		margin: 0 0 2rem;
	}
	.back a {
		text-decoration: none;
	}
	.back a:hover {
		text-decoration: underline;
	}
	.head {
		border-bottom: 1px solid var(--rule);
		padding-bottom: 1.5rem;
		margin-bottom: 2rem;
	}
	.head h1 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(1.6rem, 5vw, 2.2rem);
		margin: 0;
	}
	.cond {
		color: var(--ink-soft);
		margin: 0.6rem 0 0;
	}
	.seed {
		color: var(--ink-soft);
		font-size: 0.92rem;
		margin: 0.5rem 0 0;
	}
	.meta {
		color: var(--ink-faint);
		font-size: 0.82rem;
		margin: 0.5rem 0 0;
	}
	.convo {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.turn {
		border-left: 2px solid var(--rule);
		padding-left: 1rem;
	}
	.turn.speaker-B {
		border-left-color: var(--ink-faint);
	}
	.turn-head {
		display: flex;
		gap: 0.75rem;
		align-items: baseline;
		margin-bottom: 0.4rem;
	}
	.who {
		font-weight: 700;
		font-size: 0.8rem;
	}
	.turn-head .model {
		font-family: var(--mono);
		font-size: 0.72rem;
		color: var(--ink-faint);
	}
	.turn-head .n {
		font-size: 0.72rem;
		color: var(--ink-faint);
		margin-left: auto;
	}
	.body {
		white-space: pre-wrap;
		line-height: 1.6;
		color: var(--ink);
		font-size: 0.95rem;
	}
</style>
