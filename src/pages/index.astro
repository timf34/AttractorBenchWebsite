---
import Layout from '../layouts/Layout.astro';
import LoopMark from '../components/LoopMark.astro';
import BenchmarkTable from '../components/BenchmarkTable.astro';
---

<Layout>
	<main class="page">
		<header class="hero">
			<div class="mark">
				<LoopMark size={36} />
			</div>
			<h1 class="title">ATTRACTOR BENCH</h1>
			<p class="subtitle">
				what frontier models drift toward when AIs talk to AIs
			</p>
			<p class="lede">
				AttractorBench runs long, open-ended conversations between AI instances
				and catalogs the stable patterns — attractor states — they reliably
				drift toward. New runs are added continuously.
			</p>
		</header>

		<BenchmarkTable />

		<footer class="footer">
			<LoopMark size={18} />
			<p>AttractorBench · a public benchmark · runs added continuously</p>
		</footer>
	</main>
</Layout>

<style>
	.page {
		max-width: 880px;
		margin: 0 auto;
		padding: clamp(3rem, 8vw, 6rem) clamp(1.25rem, 5vw, 2.5rem) 4rem;
	}

	/* ---- Hero ---- */
	.hero {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}

	.mark {
		display: flex;
		justify-content: center;
		margin-bottom: 1.75rem;
	}

	.title {
		font-family: var(--serif);
		font-weight: 400;
		font-size: clamp(2.2rem, 7vw, 3.4rem);
		letter-spacing: 0.06em;
		line-height: 1.05;
		margin: 0;
		color: var(--ink);
	}

	.subtitle {
		font-style: italic;
		font-family: var(--serif);
		font-size: clamp(1rem, 3vw, 1.2rem);
		color: var(--ink-soft);
		margin: 1rem 0 0;
	}

	.lede {
		font-size: 1.02rem;
		line-height: 1.7;
		color: var(--ink-soft);
		margin: 2rem auto 0;
		max-width: 33rem;
	}

	/* ---- Footer ---- */
	.footer {
		margin-top: 5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule-faint);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		text-align: center;
	}

	.footer :global(.loop-mark) {
		opacity: 0.4;
	}

	.footer p {
		margin: 0;
		font-size: 0.82rem;
		color: var(--ink-faint);
		letter-spacing: 0.02em;
	}
</style>
