---
// Homepage section: the trait × method steering matrix + persistence summary.
// Trait data is published by the pipeline into src/data/steering/<trait>.json (+ _baseline.json).
const files = import.meta.glob('/src/data/steering/*.json', { eager: true });
const traits = [];
let baseline = null;
for (const [path, mod] of Object.entries(files)) {
	const d = mod.default;
	if (path.endsWith('_baseline.json')) baseline = d;
	else traits.push(d);
}
traits.sort((a, b) => a.trait.localeCompare(b.trait));

// Matrix columns (prompt_plain exists for only 2 traits — shown on trait pages, not here).
const COLUMNS = [
	{ key: 'prompt_grounded', label: 'Prompt (grounded)' },
	{ key: 'prompt_rich', label: 'Prompt (rich)' },
	{ key: 'lora', label: 'LoRA' },
	{ key: 'pvec', label: 'Steering vector' },
];

const rows = traits.map((t) => ({
	trait: t.trait,
	cells: COLUMNS.map((c) => {
		const m = t.methods.find((m) => m.method === c.key);
		return m ? { label: m.headline.label, strength: m.headline.strength } : null;
	}),
}));

// Persistence summary: for each trait with unsteer sweeps, the basin at the LARGEST K —
// the strongest "does it snap back?" datapoint.
const persistence = traits
	.filter((t) => t.persistence.length > 0)
	.map((t) => {
		const last = t.persistence[t.persistence.length - 1];
		return {
			trait: t.trait,
			ks: t.persistence.map((v) => v.k),
			k: last.k,
			label: last.label,
			strength: last.strength,
		};
	});
---

<section class="steering" id="steering" aria-labelledby="steering-heading">
	<div class="bar">
		<h2 id="steering-heading" class="section-title">Steering the basin</h2>
		<span class="bar-note">can you choose what a model drifts toward — and does it stick?</span>
	</div>
	<p class="intro">
		One base model — Llama&nbsp;3.1&nbsp;8B Instruct — pushed toward the same 12 persona traits
		four different ways: a persona system prompt (two phrasings), a character-trained LoRA, and
		a persona vector added directly to the residual stream. Then two copies talk. Each cell is
		the attractor basin those conversations fell into, named by the same judge as the table
		above. Click a trait for signature phrases, terminal forms, and transcripts.
	</p>

	{baseline && (
		<p class="baseline-line">
			<span class="baseline-tag">No intervention</span>
			Unsteered, the base model drifts toward <strong>{baseline.headline.label}</strong>
			{baseline.headline.strength && (
				<span class="strength-note">{baseline.headline.strength} runs</span>
			)}
			 — every basin below is a deviation from this.
		</p>
	)}

	<div class="table-scroll" role="region" aria-label="Steering matrix" tabindex="0">
		<table>
			<thead>
				<tr>
					<th scope="col">Trait</th>
					{COLUMNS.map((c) => <th scope="col">{c.label}</th>)}
				</tr>
			</thead>
			<tbody>
				{rows.map((row) => (
					<tr>
						<td class="cell-trait">
							<a href={`/steering/${row.trait}`}>{row.trait}</a>
						</td>
						{row.cells.map((cell) => (
							<td class="cell-basin">
								{cell ? (
									<>
										{cell.label}
										{cell.strength && (
											<span class="strength-note">{cell.strength}</span>
										)}
									</>
								) : (
									<span class="empty">—</span>
								)}
							</td>
						))}
					</tr>
				))}
			</tbody>
		</table>
	</div>

	{persistence.length > 0 && (
		<div class="persist">
			<div class="bar">
				<h3 class="section-title">Does it snap back?</h3>
				<span class="bar-note">steer only the first K turns, then release the vector</span>
			</div>
			<p class="persist-note">
				For these traits the steering vector is applied for the first K turns only and the
				conversation continues unsteered. The basin at the largest K tested:
			</p>
			<div class="table-scroll" role="region" aria-label="Persistence results" tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col">Trait</th>
							<th scope="col">K tested</th>
							<th scope="col">Basin after release (largest K)</th>
						</tr>
					</thead>
					<tbody>
						{persistence.map((p) => (
							<tr>
								<td class="cell-trait">
									<a href={`/steering/${p.trait}#persistence`}>{p.trait}</a>
								</td>
								<td class="cell-ks">{p.ks.join(', ')}</td>
								<td class="cell-basin">
									{p.label}
									{p.strength && <span class="strength-note">{p.strength}</span>}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	)}
</section>

<style>
	.steering {
		margin-top: 4rem;
	}
	.bar {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--rule);
	}
	.section-title {
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-soft);
		margin: 0;
	}
	.bar-note {
		font-size: 0.8rem;
		color: var(--ink-faint);
		text-align: right;
	}
	.intro {
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--ink-soft);
		margin: 1.25rem 0 0;
		max-width: 44rem;
	}
	.baseline-line {
		font-size: 0.92rem;
		color: var(--ink-soft);
		line-height: 1.6;
		margin: 1rem 0 0.5rem;
	}
	.baseline-line strong {
		color: var(--ink);
	}
	.baseline-tag {
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-faint);
		border: 1px solid var(--rule);
		border-radius: 3px;
		padding: 0.1em 0.5em;
		margin-right: 0.6em;
	}
	.table-scroll {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}
	.table-scroll:focus-visible {
		outline: 2px solid var(--ink-faint);
		outline-offset: 2px;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.88rem;
		min-width: 760px;
	}
	thead th {
		text-align: left;
		font-weight: 600;
		font-size: 0.74rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-soft);
		padding: 0.9rem 1rem 0.9rem 0;
		vertical-align: bottom;
		border-bottom: 1px solid var(--rule);
	}
	tbody td {
		padding: 0.95rem 1rem 0.95rem 0;
		border-bottom: 1px solid var(--rule-faint);
		vertical-align: top;
		line-height: 1.45;
	}
	tbody tr {
		transition: background-color 0.15s ease;
	}
	tbody tr:hover {
		background-color: var(--row-hover);
	}
	.cell-trait {
		font-weight: 600;
		white-space: nowrap;
		text-transform: capitalize;
	}
	.cell-trait a {
		color: inherit;
		text-decoration: none;
	}
	.cell-trait a:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.cell-basin {
		color: var(--ink);
		max-width: 15rem;
	}
	.cell-ks {
		font-family: var(--mono);
		font-size: 0.8rem;
		color: var(--ink-soft);
		white-space: nowrap;
	}
	.strength-note {
		color: var(--ink-faint);
		font-size: 0.74rem;
		font-family: var(--mono);
		white-space: nowrap;
		margin-left: 0.45em;
	}
	.empty {
		color: var(--ink-faint);
	}
	thead th:first-child,
	tbody td:first-child {
		padding-left: 0.25rem;
	}
	.persist {
		margin-top: 2.5rem;
	}
	.persist-note {
		font-size: 0.9rem;
		color: var(--ink-faint);
		margin: 1rem 0 0.25rem;
		max-width: 40rem;
	}
</style>
